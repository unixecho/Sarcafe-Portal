<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="il.co.sarcafe.kiosk">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- self-update through PackageInstaller (silent because the app is the device owner; see OtaUpdater) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Sarcafe Kiosk"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="fullSensor"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The app is the tablet's home screen (so it starts on boot) only while this alias is enabled.
          Kiosk mode switches it on; "Exit kiosk" switches it off, so the normal launcher shows its apps again,
          and tapping the Sarcafe Kiosk icon switches everything back on.
        -->
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".KioskAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Configuration over adb only: android.permission.DUMP is held by the adb shell and by no installed app, so no
          other app on the tablet can change the PIN, the page address, the keys or debugging. MainActivity ignores
          launch extras. Use: adb shell am broadcast -n il.co.sarcafe.kiosk/.KioskConfigReceiver plus the extras.
        -->
        <receiver
            android:name=".KioskConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          After a self-update: MY_PACKAGE_REPLACED starts the kiosk again (system broadcast, reaches a non-exported
          receiver), and the installer's result arrives here through OtaUpdater's own PendingIntent.
        -->
        <receiver
            android:name=".OtaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
