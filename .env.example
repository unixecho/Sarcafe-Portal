# Supabase project: moiunkugxgsgbdokaxbr (Frankfurt) — replaces the old
# Singapore project (gdoxoetrrfnensbahclc), which is being deleted.
NEXT_PUBLIC_SUPABASE_URL=https://moiunkugxgsgbdokaxbr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never log it. Bypasses RLS —
# used only inside API routes' requireOwner()/requireMenuEditor() guards
# and rate-limit RPC calls.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth is configured in the Supabase dashboard (Authentication ->
# Providers -> Google), not via env vars here — see SARCafe-PHASE1-PLAN.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gates /api/cron/keep-alive (Vercel Cron pings Supabase daily so the free
# tier's 7-day-inactivity auto-pause never trips). Any long random string —
# generate with e.g. `openssl rand -hex 32`. See DEPLOYMENT.md §3.6.
CRON_SECRET=

# Web Push (order-ready notifications on the customer /order/[token] page).
# Generate a real keypair with `npx web-push generate-vapid-keys` — do NOT
# reuse the same pair across environments/projects. See DEPLOYMENT.md §5.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A 'mailto:' address or 'https:' URL the push services can contact if
# they need to reach you about your usage — required by the Web Push spec.
VAPID_SUBJECT=mailto:owner@example.com
